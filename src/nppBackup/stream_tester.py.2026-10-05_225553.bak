from __future__ import annotations

from typing import Any
import requests

from .hls_utils import (
    content_type_is_media_stream,
    detect_stream_format,
    extract_bandwidth,
    extract_resolution,
    looks_like_hls_text,
    playlist_kind,
)


def test_hls_record(record: dict[str, Any], timeout: int = 10) -> dict[str, Any]:
    """Validates whether a captured stream URL responds with valid media content."""
    url = record.get("m3u8_url", "")
    headers_needed = record.get("headers_needed", {}) or {}

    headers = {}
    user_agent = headers_needed.get("User-Agent") or record.get("user_agent")
    referer = headers_needed.get("Referer") or record.get("referer") or record.get("source_page")
    origin = headers_needed.get("Origin") or record.get("origin")

    if user_agent:
        headers["User-Agent"] = user_agent
    if referer:
        headers["Referer"] = referer
    if origin:
        headers["Origin"] = origin

    result = {
        "ok": False,
        "status_code": None,
        "content_type": "",
        "playlist_type": "",
        "resolution": "",
        "bandwidth": "",
        "message": "",
        "sample": "",
    }

    if not url:
        result["message"] = "No URL selected."
        return result

    try:
        # Determine format and request strategy
        stream_format = detect_stream_format(url)

        # For progressive video files, request only the first 2KB using byte ranges
        if stream_format in ("Progressive Video", "TS Segment", "fMP4/CMAF Segment"):
            headers["Range"] = "bytes=0-2048"

        response = requests.get(url, headers=headers, timeout=timeout, allow_redirects=True)
        content_type = response.headers.get("content-type", "")
        text = response.text[:5000]

        result.update(
            {
                "status_code": response.status_code,
                "content_type": content_type,
                "playlist_type": playlist_kind(text, url, content_type),
                "resolution": extract_resolution(text),
                "bandwidth": extract_bandwidth(text),
                "sample": text[:500],
            }
        )

        # Validate HLS or DASH manifests
        if response.ok and (looks_like_hls_text(text) or content_type_is_media_stream(content_type)):
            result["ok"] = True
            result["message"] = f"Valid {stream_format} response ({response.status_code} OK)."
        # Validate partial content responses for MP4/WebM videos
        elif response.status_code == 206 or (response.ok and "video/" in content_type.lower()):
            result["ok"] = True
            result["message"] = f"Valid media stream chunk/file ({response.status_code} Partial/OK)."
        elif response.ok:
            result["message"] = (
                f"HTTP {response.status_code} OK, but body did not match standard media headers. "
                "It may require active session cookies."
            )
        else:
            result["message"] = (
                f"HTTP {response.status_code} error. The URL may be expired, token-protected, "
                "or blocked without browser session cookies."
            )
    except Exception as exc:
        result["message"] = f"Validation failed: {exc}"

    return result